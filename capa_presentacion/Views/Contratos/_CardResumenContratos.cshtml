<div class="card-resumen-container"
     data-url-resumen="@Url.Action("ResumenContratos", "Contratos")">

    <div class="card-resumen total">
        <div class="card-icon">
            <img src="~/Content/img/icons/contrato_total.svg" alt="Total contratos" />
        </div>
        <div class="card-info">
            <h3 class="card-title">Total Contratos</h3>
            <p id="cr_total_contratos" class="card-value">0</p>
        </div>
    </div>

    <div class="card-resumen activos">
        <div class="card-icon">
            <img src="~/Content/img/icons/contrato_activo.svg" alt="Contratos activos" />
        </div>
        <div class="card-info">
            <h3 class="card-title">Contratos Activos</h3>
            <p id="cr_contratos_activos" class="card-value">0</p>
        </div>
    </div>

    <div class="card-resumen por-vencer">
        <div class="card-icon">
            <img src="~/Content/img/icons/contrato_vencer.svg" alt="Contratos por vencer" />
        </div>
        <div class="card-info">
            <h3 class="card-title">Por Vencer (30 días)</h3>
            <p id="cr_por_vencer_30" class="card-value">0</p>
        </div>
    </div>

    <div class="card-resumen alertas">
        <div class="card-icon">
            <img src="~/Content/img/icons/contrato_alerta.svg" alt="Alertas legales" />
        </div>
        <div class="card-info">
            <h3 class="card-title">Alertas Legales</h3>
            <p id="cr_alertas_legales" class="card-value">0</p>
        </div>
    </div>


</div>
