@{
    ViewBag.Title = "Gestión de Contratos";
    ViewBag.PageTitle = "Gestión de Contratos";
    ViewBag.PageSubtitle = "Administra contratos, trabajadores y configuraciones del sistema";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CSS específico para esta página -->
<link href="~/Content/css/contratos.css" rel="stylesheet" />

<div class="contratos-container">
    <div class="cards-grid">
        <!-- Card: Trabajadores -->
        <div class="info-card">
            <div class="card-icon">👥</div>
            <div class="card-content">
                <h3>Trabajadores</h3>
                <p>Listado de trabajadores registrados en el sistema.</p>
                <button class="btn-primary" data-action="trabajadores">
                    <span class="btn-icon">👁️</span> Ver lista
                </button>
            </div>
        </div>

        <!-- Card: Áreas -->
        <div class="info-card">
            <div class="card-icon">🏢</div>
            <div class="card-content">
                <h3>Áreas</h3>
                <p>Consulta de áreas disponibles en la empresa.</p>
                <button class="btn-primary" data-action="areas">
                    <span class="btn-icon">👁️</span> Ver lista
                </button>
            </div>
        </div>

        <!-- Card: Cargos -->
        <div class="info-card">
            <div class="card-icon">💼</div>
            <div class="card-content">
                <h3>Cargos</h3>
                <p>Consulta de cargos o puestos disponibles.</p>
                <button class="btn-primary" data-action="cargos">
                    <span class="btn-icon">👁️</span> Ver lista
                </button>
            </div>
        </div>

        <!-- Card: Tipos de Pensión -->
        <div class="info-card">
            <div class="card-icon">💰</div>
            <div class="card-content">
                <h3>Tipos de Pensión</h3>
                <p>Listado de tipos de pensión configurados.</p>
                <button class="btn-primary" data-action="pensiones">
                    <span class="btn-icon">👁️</span> Ver lista
                </button>
            </div>
        </div>

        <!-- Card: Estados de Contrato -->
        <div class="info-card">
            <div class="card-icon">📊</div>
            <div class="card-content">
                <h3>Estados de Contrato</h3>
                <p>Consulta de los estados posibles de un contrato (activo, inactivo, finalizado, etc.).</p>
                <button class="btn-primary" data-action="estados">
                    <span class="btn-icon">👁️</span> Ver lista
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mostrar las listas -->
<div id="modalLista" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTitulo"></h2>
            <span class="close" onclick="cerrarModal()">&times;</span>
        </div>
        <div class="modal-body">
            <div id="loadingSpinner" class="loading">
                <div class="spinner"></div>
                <p>Cargando datos...</p>
            </div>
            <div id="modalContenido"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/contratos.js")"></script>
}