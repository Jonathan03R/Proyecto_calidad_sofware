@{
    ViewBag.Title = "Gestión de Contratos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Gestión de Contratos</h2>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    Trabajadores
                </div>
                <div class="card-body">
                    <p>Listado de trabajadores registrados en el sistema.</p>
                    <button class="btn btn-outline-primary btn-sm">Ver lista</button>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    Áreas
                </div>
                <div class="card-body">
                    <p>Consulta de áreas disponibles en la empresa.</p>
                    <button class="btn btn-outline-success btn-sm">Ver lista</button>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-white">
                    Cargos
                </div>
                <div class="card-body">
                    <p>Consulta de cargos o puestos disponibles.</p>
                    <button class="btn btn-outline-warning btn-sm">Ver lista</button>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white">
                    Tipos de Pensión
                </div>
                <div class="card-body">
                    <p>Listado de tipos de pensión configurados.</p>
                    <button class="btn btn-outline-info btn-sm">Ver lista</button>
                </div>
            </div>
        </div>

        <div class="col-md-12 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white">
                    Estados de Contrato
                </div>
                <div class="card-body">
                    <p>Consulta de los estados posibles de un contrato (activo, inactivo, finalizado, etc.).</p>
                    <button class="btn btn-outline-secondary btn-sm">Ver lista</button>
                </div>
            </div>
        </div>
    </div>
</div>
