@{
    ViewBag.Title = "Contratos";
    ViewBag.PageTitle = "Gestión de Contratos";
    ViewBag.PageSubtitle = "Crear Contratos - " + DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-PE"));
    ViewBag.PagePeriodo = DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-PE"));
}

<section id="page-contratos" class="page-contratos"
         data-url-listar-activos="@Url.Action("ListarActivos","Contratos")"
         data-url-listar-sin="@Url.Action("ListarSinContrato","Contratos")"
         data-url-cargos="@Url.Action("ObtenerCargos","Cargo")"
         data-url-areas="@Url.Action("ObtenerAreas","Area")">

    @Html.Partial("_CardResumenContratos")
    @Html.Partial("_FiltrosContratos")
    @Html.Partial("_TablaActivos")
    @Html.Partial("_TablaSinContrato")
    @Html.Partial("_ModalNuevoContrato")

</section>

<link rel="stylesheet" href="~/Content/css/contratos.css" />
<link rel="stylesheet" href="~/Content/css/_CardResumenContratos.css" />
<link rel="stylesheet" href="~/Content/css/_FiltrosContratos.css" />
<link rel="stylesheet" href="~/Content/css/_TablaContratos.css" />
<link rel="stylesheet" href="~/Content/css/_ModalNuevoContrato.css" />

@section Scripts{
    <script src="~/Scripts/jquery-3.7.1.min.js"></script> <!-- importante -->

    <script src="~/Scripts/contrato/contratos.js"></script>
}
