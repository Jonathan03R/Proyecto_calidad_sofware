@{
    ViewBag.Title = "Contratos";
    ViewBag.PageTitle = "Gestión de Contratos";
    ViewBag.PageSubtitle = "Crear Contratos - " + DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-PE"));
    ViewBag.PagePeriodo = DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-PE"));
}

<section id="page-contratos" class="page-contratos"
         data-url-listar-activos="@Url.Action("ListarActivos","Contratos")"
         data-url-listar-sin="@Url.Action("ListarSinContrato","Contratos")"
         data-url-obtener-areas="@Url.Action("ObtenerAreas", "Contratos")"
         data-url-obtener-cargos="@Url.Action("ObtenerCargos", "Contratos")"
         data-url-obtener-pensiones="@Url.Action("ObtenerPensiones", "Contratos")"
         data-url-obtener-tipos-salarios="@Url.Action("ObtenerTiposSalarios", "Contratos")"
         data-url-obtener-jornadas="@Url.Action("ObtenerTiposJornadas", "Contratos")"
         data-url-crear-contrato="@Url.Action("CrearContrato", "Contratos")"
         data-url-actualizar-contrato="@Url.Action("ActualizarContrato", "Contratos")"
         data-url-resumen-contratos="@Url.Action("ResumenContratos", "Contratos")">

    @Html.Partial("_CardResumenContratos")
    @Html.Partial("_FiltrosContratos")
    @Html.Partial("_TablaActivos")
    @Html.Partial("_TablaSinContrato")
    @Html.Partial("_ModalNuevoContrato")
    @Html.Partial("_ModalEditarContrato")


</section>

<link rel="stylesheet" href="~/Content/css/contratos.css" />
<link rel="stylesheet" href="~/Content/css/_CardResumenContratos.css" />
<link rel="stylesheet" href="~/Content/css/_FiltrosContratos.css" />
<link rel="stylesheet" href="~/Content/css/_TablaContratos.css" />
<link rel="stylesheet" href="~/Content/css/_ModalNuevoContrato.css" />

@section Scripts{
    <script src="~/Scripts/jquery-3.7.1.min.js"></script> <!-- importante -->

    <script src="~/Scripts/contrato/contratos.config.js"></script>
    <script src="~/Scripts/contrato/contratos.utils.js"></script>
    <script src="~/Scripts/contrato/contratos.validation.js"></script>
    <script src="~/Scripts/contrato/contratos.modal.js"></script>
    <script src="~/Scripts/contrato/contratos.catalogs.js"></script>
    <script src="~/Scripts/contrato/contratos.render.js"></script>
    <script src="~/Scripts/contrato/contratos.data.js"></script>
    <script src="~/Scripts/contrato/contratos.form.js"></script>
    <script src="~/Scripts/contrato/contratos.api.js"></script>
    <script src="~/Scripts/contrato/contratos.events.js"></script>
    <script src="~/Scripts/contrato/contratos.js"></script>
}
