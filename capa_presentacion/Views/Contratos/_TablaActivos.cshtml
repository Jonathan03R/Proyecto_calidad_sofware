@* ======================================
    PARCIAL: _TablaActivos.cshtml
    Tabla de contratos activos
    ====================================== *@

<div class="card card-table card-contratos-activos tab-panel is-active" id="tab-activos">

    <div class="card-header">
        <h3 class="card-title">Contratos Activos</h3>
        <span id="txt-total" class="card-subtitle">0 registro(s)</span>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="tabla-contratos">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Documento</th>
                        <th>Cargo</th>
                        <th>Tipo</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th style="width: 110px;">Acciones</th>
                    </tr>
                </thead>

                <!-- ESTE ES EL tbody QUE RELLENA contratos.js -->
                <tbody id="tbody-contratos">
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-state-icon">📋</div>
                                <p>Cargando contratos...</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Contenedor de paginación (si luego lo usamos) -->
        <div id="paginador" class="paginador-contratos"></div>
    </div>
</div>
