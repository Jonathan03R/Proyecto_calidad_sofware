<!-- PANELES debajo del _FiltrosContratos -->
<div id="tab-activos" class="tab-panel is-active">
    <table class="tabla-contratos">
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Documento</th>
                <th>Cargo</th>
                <th>Tipo</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
            </tr>
        </thead>
        <tbody id="tbody-contratos"><!-- aquí pintamos dinámicamente --></tbody>
    </table>

    <div class="tabla-paginacion">
        <p class="tabla-total" id="txt-total"></p>
        <div class="tabla-paginas" id="paginador"></div>
    </div>
</div>

<!-- Panel: Sin Contratos -->
<div id="tab-sin" class="tab-panel">
    <table class="tabla-contratos">
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Documento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tbody-sin-contrato"><!-- se llenará al abrir la pestaña --></tbody>
    </table>
    <div class="tabla-footer"><span id="txt-total-sin"></span></div>
</div>
