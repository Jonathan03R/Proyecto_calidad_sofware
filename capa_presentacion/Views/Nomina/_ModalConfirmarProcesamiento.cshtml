@* Views/Nomina/Partials/_ModalConfirmarProcesamiento.cshtml *@
<div id="modalConfirmar" class="modal-overlay" style="display:none;">
    <div class="modal-card">
        <h5>Confirmar procesamiento</h5>
        <p>El período seleccionado ya fue procesado. ¿Deseas continuar de todas formas?</p>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-danger" id="btnConfirmarProcesar">
                Procesar de todos modos
            </button>
            <button type="button" class="btn btn-outline-secondary" data-close="modalConfirmar">
                Cancelar
            </button>
        </div>
    </div>
</div>
