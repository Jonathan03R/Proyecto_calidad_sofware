@section Estilos {
    <link rel="stylesheet" href="~/Content/css/procesar.css" />
}

@model capa_presentacion.Models.ViewModels.ProcesarNominaResultadoVM
@{
    ViewBag.Title = "Procesando Nómina";
}

<div class="container mt-4">
    <h2 class="mb-3">Procesando Nómina</h2>

    @Html.Partial("_CardPeriodo", Model)

    <div class="progress my-3" style="height: 20px;">
        <div id="progreso" class="progress-bar" role="progressbar" style="width: 1%;" aria-valuenow="1" aria-valuemin="0" aria-valuemax="100">1%</div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h5>Vigentes</h5>
            @Html.Partial("_TablaVigentes")
        </div>
        <div class="col-md-4">
            <h5>Resumen</h5>
            @Html.Partial("_TablaResumen")
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <h5>Errores</h5>
            @Html.Partial("_TablaErrores")
        </div>
        <div class="col-md-4">
            <label class="form-label">Registro del proceso</label>
            <textarea id="log" class="form-control" rows="10" readonly>[INFO] Preparando...</textarea>
        </div>
    </div>
</div>

@Html.Partial("_Toast")

@* Opcional si no está en _Layout *@
<script src="~/Scripts/nomina/nomina.mock.api.js"></script>
<script src="~/Scripts/nomina/nomina.validation.js"></script>
<script src="~/Scripts/nomina/nomina.ui.js"></script>
