@{
    ViewBag.Title = "Historial de Nóminas";
    ViewBag.PageTitle = "Historial de Nóminas";
    ViewBag.PageSubtitle = "Revisa y gestiona ejecuciones anteriores de nómina";
}

@section Head {
    <link rel="stylesheet" href="~/Content/css/historial.css" />
}

<div class="historial-wrapper">

    <!-- FILTROS -->
    <div class="filtros">

        <div class="filtro-item">
            <label>Periodo</label>
            <select id="filtroPeriodo" class="form-control"></select>
        </div>

        <div class="filtro-item">
            <label>Estado</label>
            <select id="filtroEstado" class="form-control">
                <option value="">Todos</option>
                <option value="Exitoso">Exitoso</option>
                <option value="Incompleto">Incompleto</option>
                <option value="Procesando">Procesando</option>
            </select>
        </div>

        <div class="filtro-item">
            <label>Buscar</label>
            <input id="filtroBuscar" type="text" class="form-control" placeholder="Buscar...">
        </div>

        <button id="btnFiltrar" class="btn btn-primary">Filtrar</button>
    </div>

    <!-- TABLA -->
    <table class="tabla-historial">
        <thead>
            <tr>
                <th>Periodo</th>
                <th>Estado</th>
                <th>Empleados</th>
                <th>Bruto</th>
                <th>Descuentos</th>
                <th>Neto</th>
                <th>Procesado</th>
            </tr>
        </thead>
        <tbody id="tblHistorialBody"></tbody>
    </table>

    <!-- PAGINACIÓN -->
    <div id="paginacion" class="pagination-container"></div>

</div>

@section Scripts {
    <script src="~/Scripts/nomina/nomina.historial.js?v=@DateTime.Now.Ticks"></script>
}
