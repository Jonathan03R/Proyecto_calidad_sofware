@*@model IEnumerable<capa_presentacion.Models.ViewModels.NominaHistorialItemVM>*@
@model IEnumerable<capa_dominio.dto.NominasProcesadasDTO>


@{
    ViewBag.Title = "Historial de Nóminas";
    ViewBag.PageTitle = "Historial de Nóminas";
    ViewBag.PageSubtitle = "Revisa y gestiona las ejecuciones anteriores de nómina";
    ViewBag.PagePeriodo = "";
    var tipos = new[] { "Mensual", "Quincenal" };
}

@section Head {
    <link rel="stylesheet" href="~/Content/css/historial.css" />
}

<div class="historial-wrapper">
    <div class="historial">
        <table class="tabla-historial" id="tblHistorial">
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        <tr data-periodo="@p.PeriodoId"
                            data-tipo="@p.EstadoContratoNombre"
                            data-estado="@p.NominaEstado">

                            @* agrega aquí tus celdas reales *@

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="t-center">Sin datos</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="~/Scripts/nomina/nomina.historial.js"></script>
}
