@* Views/Nomina/Partials/_TablaVigentes.cshtml *@
<div class="panel-empleados-vigentes">
    <h5 class="panel-title">Lista de Empleados Vigentes</h5>

    <div class="panel-body">
        <div class="buscador">
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" id="txtBuscarEmpleado" placeholder="Buscar empleado..." />
            </div>
        </div>

        <div class="tabla-wrapper">
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th class="t-center">Estado</th>
                        <th class="t-center">Contrato</th>
                        <th class="t-right">Salario Base</th>
                        <th class="t-right">Asig Familiar</th>
                        <th class="t-right">H. Extras</th>
                        <th class="t-right">Salario Bruto</th>
                        <th class="t-right">Descuentos</th>
                        <th class="t-right">Salario Neto</th>
                        <th class="t-center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tblVigentesBody">
                    <tr>
                        <td colspan="11" class="t-center muted">Sin datos</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @Html.Partial("_ModalDetalleEmpleado")

</div>
