@* Views/Nomina/Partials/_TablaVigentes.cshtml *@
<div class="panel-empleados-vigentes">
    <h5 class="panel-title">Lista de Empleados sin Procesar</h5>

    <div class="panel-body">
        <div class="buscador">
            <div class="input-wrapper">
                <i class="fas fa-search icon"></i>
                <input type="text" id="txtBuscarEmpleado" placeholder="Buscar empleado..." />
            </div>
        </div>

        <div class="tabla-wrapper">
            <table class="tabla-empleados">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th class="t-center">Salario</th>
                        <th class="t-center">Tipo Pension</th>
                        <th class="t-right">Asignacion Familiar</th>
                        <th class="t-right">Cargo</th>
                        <th class="t-right">Area</th>
                        <th class="t-right">Estado</th>
                        <th class="t-right">Fecha Inicio</th>
                        <th class="t-right">Fecha Fin</th>
                    </tr>
                </thead>
                <tbody id="tblVigentesBody">
                    <tr>
                        <td colspan="11" class="t-center muted">Sin datos</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @Html.Partial("_ModalDetalleEmpleado")

</div>
