@model IEnumerable<capa_presentacion.Models.Mock.MenuItem>

@{
    var action = (string)ViewContext.RouteData.Values["action"];
}

<style>
    
</style>
<aside id="sidebar">
    <nav class="navbar-links">
        @foreach (var item in Model)
        {
            if (item.SubItems.Any())
            {
                <div class="nav-sub">
                    <button type="button" class="nav-sub-toggle" aria-expanded="false">
                        <img src="@Url.Content(item.Icono)" alt="@item.Titulo" class="icon" />
                        <span>@item.Titulo</span>
                        <span class="chev">▾</span>
                    </button>
                    <div class="nav-sub-menu">
                        @foreach (var sub in item.SubItems)
                        {
                            <a href="@Url.Action(sub.Accion, sub.Controlador)"
                               class="nav-sub-item @(action == sub.Accion ? "current" : "")">
                                @sub.Titulo
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action(item.Accion, item.Controlador)"
                   class="@(action == item.Accion ? "active" : "")">
                    <img src="@Url.Content(item.Icono)" alt="@item.Titulo" class="icon" />
                    @item.Titulo
                </a>
            }
        }
    </nav>
</aside>
    <script>
        // Control de submenús desplegables
        document.querySelectorAll('.nav-sub-toggle').forEach(btn => {
            btn.addEventListener('click', e => {
                const sub = btn.closest('.nav-sub');
                const isOpen = sub.classList.contains('open');
                document.querySelectorAll('.nav-sub').forEach(s => s.classList.remove('open'));
                if (!isOpen) sub.classList.add('open');
            });
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('.nav-sub')) {
                document.querySelectorAll('.nav-sub').forEach(s => s.classList.remove('open'));
            }
        });
    </script>
